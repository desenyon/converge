{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.concatenate.dev/converge/output/discovery-snapshot-1.0.0.schema.json",
  "title": "DiscoverySnapshot",
  "type": "object",
  "required": ["schemaVersion", "kind", "runId", "observedAt", "repository", "host", "runtimes", "packageManagers", "manifests", "lockfiles", "projects", "imports", "lockedPackages", "evidence", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "discoverySnapshot" },
    "runId": { "type": "string", "format": "uuid" },
    "observedAt": { "type": "string", "format": "date-time" },
    "repository": {
      "type": "object",
      "required": ["target", "sourceFingerprint"],
      "properties": {
        "target": { "type": "string" },
        "sourceFingerprint": { "type": "string" }
      },
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "required": ["operatingSystem", "architecture"],
      "properties": {
        "operatingSystem": { "type": "string" },
        "architecture": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runtimes": { "type": "array" },
    "packageManagers": { "type": "array" },
    "manifests": { "type": "array" },
    "lockfiles": { "type": "array" },
    "projects": { "type": "array" },
    "imports": { "type": "array" },
    "lockedPackages": { "type": "array" },
    "evidence": { "type": "array" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
